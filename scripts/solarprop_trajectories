#! /usr/bin/env python3

"""
Draw pseudo-particle trajectories.
"""

import argparse
import configparser
from copy import copy
import os
import sys
from importlib import resources

import matplotlib.pyplot as plt
import matplotlib.ticker as mticker
import numpy as np

import solarprop
from solarprop.units import AU

plt.rcParams['font.size'] = 30.0
plt.rcParams['font.family'] = 'sans-serif'
plt.rcParams['font.weight'] = 'bold'
plt.rcParams['axes.labelsize'] = 'medium'
plt.rcParams['axes.labelweight'] = 'bold'
plt.rcParams['axes.linewidth'] = 1.2
plt.rcParams['axes.titlesize'] = 'small'
plt.rcParams['axes.titleweight'] = 'bold'
plt.rcParams['xaxis.labellocation'] = 'right'
plt.rcParams['yaxis.labellocation'] = 'top'
plt.rcParams['lines.linewidth'] = 2.5
default_figsize = (9, 12)
plt.rcParams['figure.figsize'] = default_figsize

mylocator = mticker.MaxNLocator(steps=[1, 2, 5, 10], integer=True)

# helper function: convert spherical to cartesian coordinates
def x_y_z(r, theta, phi):
    x = r * np.sin(theta) * np.cos(phi)
    y = r * np.sin(theta) * np.sin(phi)
    z = r * np.cos(theta)
    return x, y, z


parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('-b', '--batch', action='store_true', help='Batch mode. Do not show plots. Useful together with the -o option.')
parser.add_argument('-c', '--control', default='', help='Control file.')
parser.add_argument('-p', '--parameters', default='', help='Specify parameters as comma-separated list of key=value pairs. Takes precedence over control file. Verbosity 4: print final step for each particle, 5: print intermediate steps.')
parser.add_argument('-e', '--ekin', type=float, default=1.0, help='Kinetic energy in GeV.')
parser.add_argument('-n', '--number', type=int, default=1, help='Number of pseudo-particle trajectories to plot.')
parser.add_argument('-o', '--output-template', default='', help='Store plots instead of showing them, use given template for file names (will be adjusted depending on the options used).')
parser.add_argument('-v', '--view', choices=['cylindrical', 'polar', '3d', 'xz', 'yz'], default='cylindrical',
                    help='Choose coordinate system for plot: "cylindrical" (default): rho=sqrt(x^2+y^2) vs z; "polar": r vs theta in a polar plot; "3d": three-dimensional view; "xz": z vs x; "yz": z vs y.')
parser.add_argument('-r', '--rmax', type=float, default=100., help='Radial boundary in AU.')
parser.add_argument('-s', '--separate', action='store_true', help='Plot each pseudo-particle trajectory in a separate figure?')
parser.add_argument('-q', '--charges', action='store_true', help='Compare results for particle charges of +1 and -1.')
parser.add_argument('--hcs', action='store_true', help='Draw heliospheric current sheet?')
args = parser.parse_args()

parameters = {
    'mass': 0.93827231,
    'charge': 1,
    'angleFile': str(resources.files(solarprop).joinpath('solarprop-data/angle.dat')),
    'omniFile': str(resources.files(solarprop).joinpath('solarprop-data/omniweb.dat')),
    'ssnFile': str(resources.files(solarprop).joinpath('solarprop-data/ssn.dat')),
}

if args.control:
    config = configparser.ConfigParser()
    # prevent ConfigParser from converting all keys to lower case, see
    #  https://stackoverflow.com/questions/19359556/configparser-reads-capital-keys-and-make-them-lower-case
    config.optionxform = str

    config.read(args.control)
    parameters |= dict(config.items('solarprop'))

if args.parameters:
    for kv in args.parameters.split(','):
        key, value = kv.split('=')
        parameters[key.strip()] = value.strip()

charges = [int(parameters.get('charge', 1))]
if args.charges:
    if 'charge' in parameters:
        del parameters['charge']
    charges = [1, -1]

for k, v in parameters.items():
    print(f'{k:20s}: {v}')

s = solarprop.Solarprop(parameters)
theta_hcs_func = np.vectorize(s.theta_hcs)

for icharge, charge in enumerate(charges):
    s.update_parameters({'charge': charge})

    trajectories = s.trajectories(args.number, args.ekin)
    if not trajectories:
        sys.exit(1)

    color = 'blue' if charge > 0 else 'red'

    # get heliospheric boundary from last step in trajectories
    r = np.array([t[-1].r() for t in trajectories if not t[-1].isInsideHeliosphere()])
    boundary = np.min(r) / AU if r.any() else 100.
    xcircle = np.arange(0., boundary+0.005*boundary, 0.005*boundary)
    # suppress warnings due to rounding errors
    err_settings = np.seterr(invalid='ignore')
    ycircle1 = np.sqrt(boundary**2 - xcircle**2)
    ycircle2 = -np.sqrt(boundary**2 - xcircle**2)
    np.seterr(**err_settings)
    rmax = min(args.rmax, boundary)
    ndots_hcs = int(rmax*10)

    for itraj, t in enumerate(trajectories):
        fignum = 'trajectories'
        if args.separate:
            fignum = f'traj {itraj} Q={charge}'
        first = args.separate or (itraj == 0 and icharge == 0)
        fsize = default_figsize
        if args.view in ['xz', 'yz']:
            fsize = (1.5*fsize[0], fsize[1])
        plt.figure(fignum, figsize=fsize)
        if args.view == 'polar':
            if first:
                plt.gcf().add_subplot(projection='polar')
                plt.gca().set_thetamax(180.)
                plt.gca().set_theta_direction(-1)
                plt.gca().set_theta_zero_location('N')
                plt.ylabel('r (AU)')
                plt.gca().yaxis.set_label_coords(0.2, 0.65)
                plt.gca().set_rmax(rmax)

            r = [p.r()/AU for p in t]
            theta = [p.theta() for p in t]
            if len(charges) < 2 and not args.separate:
                color = ''
            plt.plot(theta, r, color)
        elif args.view in ['cylindrical', 'xz' , 'yz']:
            if args.view == 'cylindrical':
                x = [p.rho()/AU for p in t]
                xlabel = r'$\rho$ (AU)'
            elif args.view == 'xz':
                x = [p.x()/AU for p in t]
                xlabel = '$x$ (AU)'
            elif args.view == 'yz':
                x = [p.y()/AU for p in t]
                xlabel = '$y$ (AU)'

            z = [p.z()/AU for p in t]
            if len(charges) < 2 and not args.separate:
                color = ''
            plt.plot(x, z, color)
            if first:
                plt.plot(xcircle, ycircle1, 'k:')
                plt.plot(xcircle, ycircle2, 'k:')
                if args.view == 'cylindrical':
                    plt.xlim(0., rmax)

                    # plot HCS representation?
                    if args.hcs:
                        r_hcs = np.linspace(0.01, rmax, ndots_hcs)  # AU
                        phi_hcs = t[-1].phi()
                        theta_hcs = theta_hcs_func(r_hcs * AU, phi_hcs)
                        x_hcs, y_hcs, z_hcs = x_y_z(r_hcs, theta_hcs, phi_hcs)
                        rho_hcs = np.hypot(x_hcs, y_hcs)
                        plt.plot(rho_hcs, z_hcs, '-', color='darkgrey', lw=0.2)
                else:
                    plt.xlim(-rmax, rmax)
                    plt.plot(-xcircle, ycircle1, 'k:')
                    plt.plot(-xcircle, ycircle2, 'k:')
                    plt.axis('equal')
                plt.ylim(-rmax, rmax)
                plt.xlabel(xlabel)
                plt.ylabel('$z$ (AU)')
                plt.gca().xaxis.set_major_locator(copy(mylocator))
                plt.gca().yaxis.set_major_locator(copy(mylocator))
                plt.tight_layout()
        elif args.view == '3d':
            if first:
                plt.gcf().add_subplot(projection='3d')
                plt.gca().set_xlim(-rmax, rmax)
                plt.gca().set_ylim(-rmax, rmax)
                plt.gca().set_zlim(-rmax, rmax)
                plt.gca().xaxis.set_major_locator(copy(mylocator))
                plt.gca().yaxis.set_major_locator(copy(mylocator))
                plt.gca().zaxis.set_major_locator(copy(mylocator))
                plt.gca().set_xlabel('$x$ (AU)')
                plt.gca().set_ylabel('$y$ (AU)')
                plt.gca().set_zlabel('$z$ (AU)')
                # plot HCS representation?
                if args.hcs:
                    r_lin = np.linspace(0.01, rmax, ndots_hcs)  # AU
                    phi_lin = np.linspace(0., 2.*np.pi, 100)
                    r_hcs, phi_hcs = np.meshgrid(r_lin, phi_lin)
                    theta_hcs = theta_hcs_func(r_hcs * AU, phi_hcs)
                    x_hcs, y_hcs, z_hcs = x_y_z(r_hcs, theta_hcs, phi_hcs)
                    plt.gca().plot_surface(x_hcs, y_hcs, z_hcs, cmap=plt.cm.RdYlGn, alpha=0.1)

            x = [p.x()/AU for p in t]
            y = [p.y()/AU for p in t]
            z = [p.z()/AU for p in t]
            if len(charges) < 2 and not args.separate:
                color = ''
            plt.gca().plot(x, y, z, color)

        # store plot?
        if args.output_template and (args.separate or (itraj == len(trajectories) - 1 and icharge == len(charges) - 1)):
            prefix, extension = os.path.splitext(args.output_template)
            if not extension:
                extension = '.png'
            suffix = ''
            if os.path.isdir(args.output_template):
                suffix = 'trajectories'
            if args.separate:
                suffix = f'_{itraj}'
            if args.separate and len(charges) > 1:
                suffix += '_pos' if charge > 0 else '_neg'
            if os.path.isdir(args.output_template):
                ofname = os.path.join(prefix, f'{suffix}{extension}')
            else:
                ofname = f'{prefix}{suffix}{extension}'
            print('Writing', ofname)
            plt.savefig(ofname)

if not args.batch:
    plt.show()
